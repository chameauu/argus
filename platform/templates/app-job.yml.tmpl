  - job_name: "$name"
    metrics_path: $metrics_path
    scrape_interval: $interval
    static_configs:
      - targets: ["$target"]
    metric_relabel_configs:
      # Cardinality guard. Only labels the platform knows about survive the
      # scrape; everything else is dropped before it reaches the TSDB. One app
      # that puts an order id or a user id in a label multiplies series without
      # bound and ends the stack; this allowlist costs one regex per scrape and
      # is cheaper than the outage. A missing dimension label does not reduce
      # cardinality: it silently merges distinct series onto one label set, and
      # Prometheus keeps only one sample per timestamp (python_gc_* loses
      # generation this way). `type`, `mode`, `code`, `method`, `handler` and
      # `generation` are therefore kept, not dropped. __name__, job and instance
      # are injected by Prometheus and must be kept, as must le/quantile for
      # histograms and summaries. Infrastructure jobs (prometheus, alertmanager,
      # node-exporter, cadvisor, alloy) do not get this guard: their label sets
      # are large and legitimately varied.
      - action: labelkeep
        regex: "__name__|service|route|endpoint|status|le|quantile|job|instance|version|generation|type|mode|code|method|handler"
      - target_label: service
        replacement: $name
