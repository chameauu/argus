# Generated by platform/generate.py from services/$name.yaml. Do not edit by hand.
groups:
  - name: red-$name
    rules:
      - alert: $down_alert
        expr: up{job="$name"} == 0
        for: 2m
        labels:
          severity: critical
          service: $name
          runbook: $generated_runbook
        annotations:
          summary: "$name is not being scraped"
          description: "Prometheus has failed to scrape $name for 2 minutes."

      - alert: $error_alert
        expr: |
          (
            sum(rate($requests_metric{service="$name",$error_selector}[5m]))
            /
            sum(rate($requests_metric{service="$name"}[5m]))
          ) > 0.05
        for: 5m
        labels:
          severity: critical
          service: $name
          runbook: $generated_runbook
        annotations:
          summary: "High 5xx error rate on $name"
          description: "More than 5% of $name requests returned 5xx over 5 minutes."

      - alert: $latency_alert
        expr: |
          histogram_quantile(
            0.99,
            sum by (le, $route_label) (
              rate($latency_bucket{service="$name"}[5m])
            )
          ) > $threshold
        for: 5m
        labels:
          severity: warning
          service: $name
          runbook: $generated_runbook
        annotations:
          summary: "p99 latency above $threshold s on $name"
          description: "p99 $route_label latency on $name exceeded $threshold s for 5 minutes."
