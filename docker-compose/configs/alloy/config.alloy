// Grafana Alloy — Docker log pipeline (replaces the EOL Promtail shipper).
//
// Label parity with the retired promtail-config.yml is intentional:
//   container       = <docker container name>  (leading "/" stripped)
//   compose_service = com.docker.compose.service
//   compose_project = com.docker.compose.project
//   logstream       = stdout | stderr
//
// Loki adds service_name from the container label at ingest time
// (limits_config.discover_service_name), exactly as it did before.
//
// Read positions live in /var/lib/alloy/data (named volume). loki.source.docker
// has no tail_from_end, so a fresh volume replays every container log from the
// beginning. loki.process "filter" drops entries older than one hour before
// they reach Loki, so the replay is filtered rather than written wholesale and
// `down -v` needs no hand-seeded positions. Loki's own
// `loki_process_dropped_lines_total` counter (Alloy /metrics on :12345) is the
// evidence that the filter, not silence, handled the replay.

// Discover every container on the host, then keep only this compose project.
// Without the keep rule, unrelated containers on this host flood Loki.
discovery.docker "argus" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "argus_keep" {
  targets = discovery.docker.argus.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "argus"
    action        = "keep"
  }
}

// Per-entry rules: docker exposes the stream (stdout/stderr) per log line as
// __meta_docker_container_log_stream, so these must run inside the source.
loki.relabel "argus" {
  forward_to = []

  // Container name arrives as "/<name>" — strip the leading slash.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Docker Compose labels -> first-class queryable labels.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  // stdout vs stderr.
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "logstream"
  }
}

loki.source.docker "argus" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.argus_keep.output
  relabel_rules = loki.relabel.argus.rules
  forward_to    = [loki.process.filter.receiver]
}

// Filter the cold-start replay: live logs are seconds old, so only replayed
// history is dropped. Dropped lines increment loki_process_dropped_lines_total.
loki.process "filter" {
  forward_to = [loki.write.default.receiver]

  stage.drop {
    older_than          = "1h"
    drop_counter_reason = "replay"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
